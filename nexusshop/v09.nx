
// NexusShop v0.9 - Shopify + Mercado Libre fusionados
clase NexusShop {
    def __init__() {
        este.tiendas = {}
        este.slugs = []
        este.visitas = {}
        este.admin = "542257550650"
        imprimir("🛒 NexusShop v0.9 - Shopify + MercadoLibre fusionados")
    }

    def crear_tienda(slug, nombre, whatsapp, emoji, estrellas, ventas) {
        este.tiendas[slug] = {"nombre": nombre, "whatsapp": whatsapp, "emoji": emoji, "estrellas": estrellas, "ventas": ventas, "productos": []}
        este.slugs = este.slugs + [slug]
        este.visitas[slug] = 0
    }

    def agregar_producto(slug, nombre, precio, emoji, cat, vendidos) {
        este.tiendas[slug]["productos"] = este.tiendas[slug]["productos"] + [{"nombre": nombre, "precio": precio, "emoji": emoji, "cat": cat, "vendidos": vendidos}]
    }

    def tarjeta_ml(p, t) {
        envio = ""
        si (p["precio"] >= 50) {
            envio = " <small style='color:seagreen;font-weight:bold'>· 🚚 Envío gratis</small>"
        } sino {
            envio = ""
        }
        link = "https://wa.me/" + t["whatsapp"] + "?text=Hola+quiero+comprar+" + p["nombre"]
        devolver "<div style='background:white;color:black;border-radius:12px;padding:16px;margin:10px 0;display:flex;justify-content:space-between;align-items:center'><div><span style='font-size:30px'>" + p["emoji"] + "</span> <b style='color:black;font-size:16px'>" + p["nombre"] + "</b><br><span style='color:seagreen;font-size:22px;font-weight:bold'>$" + texto(p["precio"]) + "</span>" + envio + "<br><small style='color:gray'>⭐ " + texto(t["estrellas"]) + " · " + texto(p["vendidos"]) + " vendidos · por " + t["emoji"] + " " + t["nombre"] + "</small></div><a href='" + link + "' style='background:seagreen;color:white;padding:10px 18px;border-radius:8px;text-decoration:none;font-weight:bold'>Comprar</a></div>"
    }

    def categoria(cat, titulo) {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:30px 20px'><h1 style='color:white'>" + titulo + "</h1><p style='color:lightgray'>Todos los vendedores · un solo carrito de WhatsApp</p>"
        para s en este.slugs {
            t = este.tiendas[s]
            para p en t["productos"] {
                si (p["cat"] == cat) {
                    contenido = contenido + este.tarjeta_ml(p, t)
                }
            }
        }
        contenido = contenido + "<p style='color:lightgray;font-size:13px;text-align:center'>NexusShop Marketplace · Hecho con NexusLang</p></div>"
        devolver web.pagina(titulo, contenido)
    }

    def vista_tienda(slug) {
        t = este.tiendas[slug]
        este.visitas[slug] = este.visitas[slug] + 1
        pedido = "Hola+quiero+pedir+"
        contenido = "<div style='max-width:900px;margin:0 auto;padding:30px 20px'>"
        contenido = contenido + "<h1 style='color:white'>" + t["emoji"] + " " + t["nombre"] + " <small style='color:seagreen'>✓ Verificada</small></h1>"
        contenido = contenido + "<p style='color:lightgray'>⭐ " + texto(t["estrellas"]) + " · " + texto(t["ventas"]) + " ventas · 👀 " + texto(este.visitas[slug]) + " visitas</p>"
        para p en t["productos"] {
            contenido = contenido + este.tarjeta_ml(p, t)
            pedido = pedido + p["nombre"] + "+"
        }
        contenido = contenido + "<div style='text-align:center;margin:20px 0'><a href='https://wa.me/" + t["whatsapp"] + "?text=" + pedido + "' style='background:black;color:white;padding:14px 26px;border-radius:8px;text-decoration:none;font-weight:bold'>🛒 Pedir TODO por WhatsApp</a></div>"
        contenido = contenido + "<p style='color:lightgray;font-size:13px;text-align:center'>Tienda oficial NexusShop · Hecha con NexusLang</p></div>"
        devolver web.pagina(t["nombre"], contenido)
    }

    def landing() {
        total_prod = 0
        total_vis = 0
        para s en este.slugs {
            total_prod = total_prod + len(este.tiendas[s]["productos"])
            total_vis = total_vis + este.visitas[s]
        }
        contenido = "<div style='max-width:900px;margin:0 auto;padding:40px 20px;text-align:center'>"
        contenido = contenido + "<div style='font-size:60px'>🛒</div>"
        contenido = contenido + "<h1 style='font-size:44px;color:white'>Nexus<span style='color:seagreen'>Shop</span></h1>"
        contenido = contenido + "<p style='color:lightgray;font-size:18px'>Tu tienda propia + el marketplace soberano.<br>Sin comisiones abusivas. Sin Big Tech. Pedidos por WhatsApp.</p>"
        contenido = contenido + "<div style='background:black;color:white;border-radius:12px;padding:14px;margin:20px auto;max-width:520px'>📊 EN VIVO: " + texto(len(este.slugs)) + " tiendas · " + texto(total_prod) + " productos · " + texto(total_vis) + " visitas</div>"
        contenido = contenido + "<h2 style='color:white'>🗂️ Categorías</h2>"
        contenido = contenido + "<div style='display:flex;gap:14px;justify-content:center;flex-wrap:wrap'><a href='/cat/tecnologia' style='background:white;color:black;border-radius:12px;padding:18px 26px;text-decoration:none;font-weight:bold'>💻 Tecnología</a><a href='/cat/alimentos' style='background:white;color:black;border-radius:12px;padding:18px 26px;text-decoration:none;font-weight:bold'>🥐 Alimentos</a><a href='/cat/educacion' style='background:white;color:black;border-radius:12px;padding:18px 26px;text-decoration:none;font-weight:bold'>🎓 Educación</a></div>"
        contenido = contenido + "<h2 style='color:white;margin-top:30px'>🔥 Lo más vendido</h2>"
        contenido = contenido + "<div style='text-align:left;max-width:700px;margin:0 auto'>"
        para s en este.slugs {
            t = este.tiendas[s]
            para p en t["productos"] {
                si (p["vendidos"] >= 100) {
                    contenido = contenido + este.tarjeta_ml(p, t)
                }
            }
        }
        contenido = contenido + "</div>"
        contenido = contenido + "<h2 style='color:white;margin-top:30px'>🏪 Vendedores</h2>"
        contenido = contenido + "<div style='display:flex;gap:14px;justify-content:center;flex-wrap:wrap'>"
        para s en este.slugs {
            t = este.tiendas[s]
            contenido = contenido + "<a href='/tienda/" + s + "' style='background:white;color:black;border-radius:12px;padding:14px 20px;text-decoration:none'><b>" + t["emoji"] + " " + t["nombre"] + "</b><br><small style='color:gray'>⭐ " + texto(t["estrellas"]) + "</small></a>"
        }
        contenido = contenido + "</div>"
        contenido = contenido + "<h2 style='color:white;margin-top:30px'>💰 Planes para vendedores</h2>"
        contenido = contenido + "<div style='display:flex;gap:14px;justify-content:center;flex-wrap:wrap'><div style='background:white;color:black;border-radius:12px;padding:20px;width:220px'><b>GRATIS</b><br><span style='font-size:26px'>$0</span><br><small>10 productos · catálogo WhatsApp</small></div><div style='background:black;color:white;border-radius:12px;padding:20px;width:220px'><b>PRO</b><br><span style='font-size:26px'>$15/mes</span><br><small>ilimitados + dominio propio</small></div><div style='background:white;color:black;border-radius:12px;padding:20px;width:220px'><b>ENTERPRISE</b><br><span style='font-size:26px'>$49/mes</span><br><small>multi-sucursal + API</small></div></div>"
        contenido = contenido + "<p style='color:lightgray;margin-top:26px'>Hecho con NexusLang — el primer lenguaje de programación bilingüe.</p></div>"
        devolver web.pagina("NexusShop - El marketplace soberano", contenido)
    }

    def directorio() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:30px 20px'><h1 style='color:white'>🛍️ Tiendas en vivo</h1>"
        para s en este.slugs {
            t = este.tiendas[s]
            contenido = contenido + "<a href='/tienda/" + s + "' style='display:block;background:white;color:black;border-radius:12px;padding:18px;margin:12px 0;text-decoration:none'><b style='font-size:18px;color:black'>" + t["emoji"] + " " + t["nombre"] + "</b> <span style='color:gray'>· ⭐ " + texto(t["estrellas"]) + " · " + texto(len(t["productos"])) + " productos</span></a>"
        }
        contenido = contenido + "</div>"
        devolver web.pagina("Tiendas - NexusShop", contenido)
    }

    def datos() {
        devolver {"plataforma": "NexusShop", "version": "0.9", "modelo": "Shopify + MercadoLibre", "tiendas": len(este.slugs), "motor": "NexusLang 5.3", "soberano": verdadero}
    }
}

shop = NexusShop()

shop.crear_tienda("demo", "Tech Store Demo", "542257550650", "💻", 4.8, 320)
shop.agregar_producto("demo", "Laptop Pro", 999, "💻", "tecnologia", 150)
shop.agregar_producto("demo", "Mouse Gamer", 29, "🖱️", "tecnologia", 400)
shop.agregar_producto("demo", "Teclado Mecánico", 89, "⌨️", "tecnologia", 120)

shop.crear_tienda("lucas", "Nexus Official Store", "542257550650", "🦅", 5.0, 510)
shop.agregar_producto("lucas", "Curso NexusLang", 49, "🎓", "educacion", 380)
shop.agregar_producto("lucas", "Licencia Pro", 99, "🔑", "educacion", 130)

shop.crear_tienda("cafe", "Café de Mar", "542257550650", "☕", 4.9, 980)
shop.agregar_producto("cafe", "Café Molido 500g", 8, "☕", "alimentos", 850)
shop.agregar_producto("cafe", "Medialunas x6", 5, "🥐", "alimentos", 1200)

shop.crear_tienda("almacen", "Almacén Don José", "542257550650", "🏪", 4.7, 640)
shop.agregar_producto("almacen", "Pan Casero", 3, "🍞", "alimentos", 900)
shop.agregar_producto("almacen", "Miel 500g", 6, "🍯", "alimentos", 300)
shop.agregar_producto("almacen", "Aceite de Oliva", 9, "🫒", "alimentos", 210)

def inicio() => shop.landing()
def tiendas() => shop.directorio()
def v_demo() => shop.vista_tienda("demo")
def v_lucas() => shop.vista_tienda("lucas")
def v_cafe() => shop.vista_tienda("cafe")
def v_almacen() => shop.vista_tienda("almacen")
def c_tec() => shop.categoria("tecnologia", "💻 Tecnología")
def c_ali() => shop.categoria("alimentos", "🥐 Alimentos")
def c_edu() => shop.categoria("educacion", "🎓 Educación")
def api() => shop.datos()

s = web.servidor(8091)
s.ruta("/", inicio)
s.ruta("/tiendas", tiendas)
s.ruta("/tienda/demo", v_demo)
s.ruta("/tienda/lucas", v_lucas)
s.ruta("/tienda/cafe", v_cafe)
s.ruta("/tienda/almacen", v_almacen)
s.ruta("/cat/tecnologia", c_tec)
s.ruta("/cat/alimentos", c_ali)
s.ruta("/cat/educacion", c_edu)
s.ruta("/api", api)
imprimir("✅ NexusShop v0.9 en http://localhost:8091")
s.iniciar()
