
// NexusShop v1.6 - UX grande + precios honestos + logo
clase NexusShop {
    def __init__() {
        este.tiendas = {}
        este.slugs = []
        este.visitas = {}
        este.admin = "542257550650"
        imprimir("🎨 NexusShop v1.6 - UX grande + logo")
    }

    def guardar() {
        db.nexusshop.tiendas = este.tiendas
        db.nexusshop.slugs = este.slugs
    }

    def crear_tienda(slug, nombre, whatsapp, emoji, estrellas, ventas, envios) {
        este.tiendas[slug] = {"nombre": nombre, "whatsapp": whatsapp, "emoji": emoji, "estrellas": estrellas, "ventas": ventas, "envios": envios, "productos": []}
        este.slugs = este.slugs + [slug]
        este.visitas[slug] = 0
    }

    def agregar_producto(slug, nombre, precio, emoji, cat, vendidos, antes) {
        este.tiendas[slug]["productos"] = este.tiendas[slug]["productos"] + [{"nombre": nombre, "precio": precio, "emoji": emoji, "cat": cat, "vendidos": vendidos, "antes": antes}]
    }

    def logo(tam, fuente) {
        devolver "<div style='width:" + tam + ";height:" + tam + ";border-radius:50%;border:3px solid fuchsia;box-shadow:0 0 18px fuchsia;background:black;display:inline-flex;align-items:center;justify-content:center'><span style='font-size:" + fuente + "'>🛒</span></div>"
    }

    def topbar() {
        devolver "<div style='max-width:900px;margin:0 auto;padding:12px 16px;display:flex;gap:12px;align-items:center;position:sticky;top:0;z-index:98;background:black'><a href='/' style='text-decoration:none'>" + este.logo("46px", "22px") + "</a><a href='/buscar' style='flex:1;background:black;color:lightgray;border:1px solid aqua;border-radius:26px;box-shadow:0 0 8px aqua;padding:15px 22px;text-decoration:none;font-size:16px'>🔍 Buscar en NexusShop</a><a href='/confianza' style='font-size:24px;text-decoration:none'>🔔</a></div>"
    }

    def tabs() {
        devolver "<div style='max-width:900px;margin:0 auto;padding:0 16px;display:flex;gap:18px;overflow-x:auto'><a href='/' style='color:aqua;text-decoration:none;font-weight:bold;border-bottom:3px solid aqua;padding:10px 2px;font-size:15px'>Todo</a><a href='/ofertas' style='color:lightgray;text-decoration:none;font-size:15px;padding:10px 2px'>Ofertas</a><a href='/cat/tecnologia' style='color:lightgray;text-decoration:none;font-size:15px;padding:10px 2px'>Tecnología</a><a href='/cat/alimentos' style='color:lightgray;text-decoration:none;font-size:15px;padding:10px 2px'>Alimentos</a><a href='/cat/educacion' style='color:lightgray;text-decoration:none;font-size:15px;padding:10px 2px'>Educación</a><a href='/cat/moda' style='color:lightgray;text-decoration:none;font-size:15px;padding:10px 2px'>Moda</a><a href='/cat/salud' style='color:lightgray;text-decoration:none;font-size:15px;padding:10px 2px'>Salud</a></div>"
    }

    def bottom() {
        devolver "<div style='position:fixed;bottom:0;left:0;right:0;background:black;border-top:1px solid aqua;box-shadow:0 0 14px aqua;display:flex;justify-content:space-around;padding:12px 0;z-index:99'><a href='/' style='color:aqua;text-decoration:none;font-size:15px;text-align:center'>🏠<br>Inicio</a><a href='/tiendas' style='color:white;text-decoration:none;font-size:15px;text-align:center'>🗂️<br>Categorías</a><a href='/ofertas' style='color:white;text-decoration:none;font-size:15px;text-align:center'>🔥<br>Ofertas</a><a href='/vender' style='color:white;text-decoration:none;font-size:15px;text-align:center'>💰<br>Vender</a><a href='/ayuda' style='color:white;text-decoration:none;font-size:15px;text-align:center'>⚙️<br>Más</a></div>"
    }

    def pie() {
        devolver "<div style='max-width:900px;margin:0 auto;padding:24px 20px 95px;text-align:center;color:lightgray;font-size:14px'><a href='/nosotros' style='color:lightgray'>Nosotros</a> · <a href='/confianza' style='color:lightgray'>Confianza</a> · <a href='/terminos' style='color:lightgray'>Términos</a> · <a href='/privacidad' style='color:lightgray'>Privacidad</a> · <a href='/api' style='color:lightgray'>API</a><br>NexusShop · marketplace argentino · compra protegida</div>" + este.bottom()
    }

    def envolver(titulo, cuerpo) {
        devolver web.pagina(titulo, este.topbar() + cuerpo + este.pie())
    }

    def caja(titulo, cuerpo) {
        devolver "<div style='background:black;color:white;border:1px solid aqua;border-radius:14px;box-shadow:0 0 10px aqua;padding:20px;margin:12px 0;font-size:15px'><b style='color:aqua;font-size:16px'>" + titulo + "</b><br>" + cuerpo + "</div>"
    }

    def tarjeta_neon(p, t, slug, i) {
        envio = ""
        si (p["precio"] >= 50) {
            envio = " <small style='color:lime;font-weight:bold'>· 🚚 Envío gratis</small>"
        } sino {
            envio = ""
        }
        oferta = ""
        si (p["antes"] > 0) {
            oferta = " <small style='color:gray'>lista $" + texto(p["antes"]) + "</small> <span style='background:fuchsia;color:white;border-radius:8px;padding:4px 10px;font-size:13px;font-weight:bold'>⚡ PRECIO NEXUS</span>"
        }
        devolver "<div style='background:black;color:white;border:1px solid aqua;border-radius:16px;box-shadow:0 0 10px aqua;padding:20px;margin:12px 0;display:flex;justify-content:space-between;align-items:center'><div><span style='font-size:34px'>" + p["emoji"] + "</span> <b style='color:white;font-size:17px'>" + p["nombre"] + "</b><br><span style='color:lime;font-size:24px;font-weight:bold;text-shadow:0 0 8px lime'>$" + texto(p["precio"]) + "</span>" + oferta + envio + "<br><small style='color:lightgray;font-size:13px'>⭐ " + texto(t["estrellas"]) + " · " + texto(p["vendidos"]) + " vendidos · 🛡️ " + t["emoji"] + " " + t["nombre"] + "</small></div><a href='/comprar/" + slug + texto(i) + "' style='background:fuchsia;color:white;padding:18px 34px;border-radius:28px;text-decoration:none;font-weight:bold;font-size:18px;box-shadow:0 0 12px fuchsia'>Comprar</a></div>"
    }

    def buscar() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:20px'><h1 style='color:white;text-shadow:0 0 10px aqua'>🔍 Buscá como en las grandes</h1><p style='color:lightgray;font-size:15px'>Búsquedas populares de la semana:</p><div style='display:flex;gap:12px;flex-wrap:wrap'><a href='/cat/tecnologia' style='background:black;color:aqua;border:1px solid aqua;border-radius:24px;padding:14px 20px;text-decoration:none;font-size:15px'>laptop</a><a href='/cat/alimentos' style='background:black;color:aqua;border:1px solid aqua;border-radius:24px;padding:14px 20px;text-decoration:none;font-size:15px'>café</a><a href='/cat/alimentos' style='background:black;color:aqua;border:1px solid aqua;border-radius:24px;padding:14px 20px;text-decoration:none;font-size:15px'>medialunas</a><a href='/cat/moda' style='background:black;color:aqua;border:1px solid aqua;border-radius:24px;padding:14px 20px;text-decoration:none;font-size:15px'>vestido</a><a href='/cat/salud' style='background:black;color:aqua;border:1px solid aqua;border-radius:24px;padding:14px 20px;text-decoration:none;font-size:15px'>melatonina</a><a href='/top' style='background:black;color:fuchsia;border:1px solid fuchsia;border-radius:24px;padding:14px 20px;text-decoration:none;font-size:15px'>🏆 lo más vendido</a></div></div>"
        devolver este.envolver("Buscar - NexusShop", contenido)
    }

    def categoria(cat, titulo) {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:20px'><h1 style='color:white;text-shadow:0 0 10px fuchsia'>" + titulo + "</h1><p style='color:lightgray'>🛡️ Vendedores verificados · compra protegida</p>"
        para s en este.slugs {
            t = este.tiendas[s]
            para i en [0, 1, 2, 3, 4] {
                si (i < len(t["productos"])) {
                    p = t["productos"][i]
                    si (p["cat"] == cat) {
                        contenido = contenido + este.tarjeta_neon(p, t, s, i)
                    }
                }
            }
        }
        contenido = contenido + "</div>"
        devolver este.envolver(titulo, contenido)
    }

    def comprar(slug, i) {
        t = este.tiendas[slug]
        p = t["productos"][i]
        contenido = "<div style='max-width:900px;margin:0 auto;padding:20px'>"
        contenido = contenido + "<div style='background:black;color:white;border:1px solid fuchsia;border-radius:16px;box-shadow:0 0 14px fuchsia;padding:24px;text-align:center'><div style='font-size:64px'>" + p["emoji"] + "</div><h1 style='color:white'>" + p["nombre"] + "</h1><span style='color:lime;font-size:36px;font-weight:bold;text-shadow:0 0 10px lime'>$" + texto(p["precio"]) + "</span><br><small style='color:lightgray;font-size:14px'>⭐ " + texto(t["estrellas"]) + " · " + texto(p["vendidos"]) + " vendidos · 🛡️ " + t["emoji"] + " " + t["nombre"] + " ✓ verificado</small></div>"
        contenido = contenido + "<div style='background:black;color:white;border:1px solid aqua;border-radius:14px;box-shadow:0 0 10px aqua;padding:14px;margin:12px 0;font-size:14px'>🛡️ Compra Protegida: pagás al recibir, directo al vendedor. NexusShop nunca te pide claves ni códigos.</div>"
        contenido = contenido + "<h2 style='color:aqua;text-shadow:0 0 8px aqua;font-size:20px'>Elegí pago y envío — tocá tu combo:</h2>"
        para pg en ["💵 efectivo", "🏦 transferencia", "💳 MercadoPago"] {
            para ev en t["envios"] {
                link = "https://wa.me/" + t["whatsapp"] + "?text=Hola+compro+" + p["nombre"] + "+-+pago:" + pg + "+-+envio:" + ev
                contenido = contenido + "<a href='" + link + "' style='display:block;background:black;color:aqua;border:1px solid fuchsia;border-radius:24px;padding:16px;margin:10px 0;text-decoration:none;text-align:center;font-size:16px;box-shadow:0 0 8px fuchsia'>" + pg + " + " + ev + "</a>"
            }
        }
        contenido = contenido + "<p style='text-align:center;color:lightgray;font-size:13px'>Al tocar, se abre tu WhatsApp con el pedido completo al vendedor.<br>El chat es tu comprobante. NexusShop no toca tu dinero.</p>"
        contenido = contenido + "<p style='text-align:center'><a href='https://wa.me/542257550650?text=Quiero+reportar+al+vendedor+" + slug + "' style='color:lightgray;font-size:13px'>⚠️ Reportar vendedor</a></p></div>"
        devolver este.envolver("Comprar " + p["nombre"], contenido)
    }

    def vista_tienda(slug) {
        t = este.tiendas[slug]
        este.visitas[slug] = este.visitas[slug] + 1
        texto_envios = ""
        para e en t["envios"] {
            texto_envios = texto_envios + e + " · "
        }
        contenido = "<div style='max-width:900px;margin:0 auto;padding:20px'>"
        contenido = contenido + "<h1 style='color:white;text-shadow:0 0 10px aqua'>" + t["emoji"] + " " + t["nombre"] + " <small style='color:lime'>✓ Verificada</small></h1>"
        contenido = contenido + "<p style='color:lightgray'>⭐ " + texto(t["estrellas"]) + " · " + texto(t["ventas"]) + " ventas · 👀 " + texto(este.visitas[slug]) + " visitas</p>"
        contenido = contenido + "<div style='background:black;color:white;border:1px solid aqua;border-radius:12px;padding:14px;margin:10px 0;font-size:14px'>🚚 Envíos: " + texto_envios + "</div>"
        para i en [0, 1, 2, 3, 4] {
            si (i < len(t["productos"])) {
                contenido = contenido + este.tarjeta_neon(t["productos"][i], t, slug, i)
            }
        }
        contenido = contenido + "</div>"
        devolver este.envolver(t["nombre"], contenido)
    }

    def landing() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:16px'>"
        contenido = contenido + "<div style='text-align:center;margin:6px 0 14px'>" + este.logo("92px", "44px") + "<br><b style='color:white;font-size:28px;text-shadow:0 0 14px aqua'>Nexus<span style='color:aqua'>Shop</span></b></div>"
        contenido = contenido + este.tabs()
        contenido = contenido + "<div style='background:black;color:white;border:1px solid fuchsia;border-radius:16px;box-shadow:0 0 16px fuchsia;padding:26px;margin:14px 0;text-align:center'><b style='font-size:28px;color:fuchsia;text-shadow:0 0 12px fuchsia'>⚡ DESCUENTAZOS NEÓN</b><br><span style='color:lime;font-size:20px;font-weight:bold'>HASTA $500 OFF · 18 CUOTAS SIN INTERÉS</span><br><small style='color:lightgray;font-size:14px'>en productos seleccionados del marketplace</small></div>"
        contenido = contenido + "<marquee style='background:black;color:lime;border:1px solid lime;border-radius:12px;padding:12px;font-size:15px;font-weight:bold' scrollamount='6'>🚚 Envío gratis en tu primera compra · 🛡️ Compra Protegida: el cliente siempre gana · ⚡ Precios Nexus declarados por el vendedor · 🇦 Hecho en Argentina · 🔐 Sin trackers · 📲 Instalá NexusShop: menú Chrome, Agregar a pantalla de inicio</marquee>"
        contenido = contenido + "<div style='display:flex;gap:14px;justify-content:space-around;margin:20px 0;overflow-x:auto'><a href='/ofertas' style='text-align:center;text-decoration:none'><div style='width:74px;height:74px;border-radius:50%;background:black;border:1px solid aqua;box-shadow:0 0 10px aqua;display:flex;align-items:center;justify-content:center;font-size:30px'>🏷️</div><small style='color:white;font-size:13px'>Ofertazo</small></a><a href='/top' style='text-align:center;text-decoration:none'><div style='width:74px;height:74px;border-radius:50%;background:black;border:1px solid aqua;box-shadow:0 0 10px aqua;display:flex;align-items:center;justify-content:center;font-size:30px'>🏆</div><small style='color:white;font-size:13px'>Top</small></a><a href='/envios' style='text-align:center;text-decoration:none'><div style='width:74px;height:74px;border-radius:50%;background:black;border:1px solid aqua;box-shadow:0 0 10px aqua;display:flex;align-items:center;justify-content:center;font-size:30px'>🚚</div><small style='color:white;font-size:13px'>Envíos</small></a><a href='/cat/alimentos' style='text-align:center;text-decoration:none'><div style='width:74px;height:74px;border-radius:50%;background:black;border:1px solid aqua;box-shadow:0 0 10px aqua;display:flex;align-items:center;justify-content:center;font-size:30px'>🥐</div><small style='color:white;font-size:13px'>Súper</small></a><a href='/cat/salud' style='text-align:center;text-decoration:none'><div style='width:74px;height:74px;border-radius:50%;background:black;border:1px solid aqua;box-shadow:0 0 10px aqua;display:flex;align-items:center;justify-content:center;font-size:30px'>🌿</div><small style='color:white;font-size:13px'>Farmacia</small></a><a href='/cat/tecnologia' style='text-align:center;text-decoration:none'><div style='width:74px;height:74px;border-radius:50%;background:black;border:1px solid aqua;box-shadow:0 0 10px aqua;display:flex;align-items:center;justify-content:center;font-size:30px'>💻</div><small style='color:white;font-size:13px'>Tecno</small></a></div>"
        contenido = contenido + "<div style='background:black;color:white;border:1px solid aqua;border-radius:16px;box-shadow:0 0 10px aqua;padding:22px;margin:14px 0;text-align:center'><b style='font-size:18px'>¡Creá tu tienda y vendé desde hoy!</b><br><div style='margin:16px 0'><a href='https://wa.me/542257550650?text=Quiero+mi+tienda+NexusShop' style='background:aqua;color:black;padding:18px 30px;border-radius:12px;font-weight:bold;text-decoration:none;display:block;font-size:18px;box-shadow:0 0 14px aqua'>Crear mi tienda GRATIS</a></div><a href='/vender' style='color:aqua;font-size:15px'>Ver beneficios para vendedores</a></div>"
        contenido = contenido + "<div style='display:flex;gap:12px;margin:14px 0;flex-wrap:wrap'><div style='flex:1 1 320px;background:black;border:1px solid fuchsia;border-radius:14px;box-shadow:0 0 10px fuchsia;padding:16px'><b style='color:fuchsia;text-shadow:0 0 8px fuchsia;font-size:16px'>⚡ OFERTAS RELÁMPAGO</b> <span style='background:black;color:lime;border:1px solid lime;border-radius:6px;padding:3px 9px;font-size:13px'>02:18:30</span>"
        para s en este.slugs {
            t = este.tiendas[s]
            para i en [0, 1, 2, 3, 4] {
                si (i < len(t["productos"])) {
                    p = t["productos"][i]
                    si (p["antes"] > 0) {
                        contenido = contenido + "<a href='/comprar/" + s + texto(i) + "' style='display:block;border:1px solid aqua;border-radius:12px;padding:14px;margin:10px 0;text-decoration:none'><small style='color:white;font-size:14px'>" + p["emoji"] + " " + p["nombre"] + "</small><br><small style='color:gray'>lista $" + texto(p["antes"]) + "</small> <b style='color:lime;font-size:16px'>$" + texto(p["precio"]) + "</b> <span style='background:fuchsia;color:white;border-radius:6px;padding:2px 7px;font-size:12px'>PRECIO NEXUS</span></a>"
                    }
                }
            }
        }
        contenido = contenido + "</div><div style='flex:1 1 320px'><div style='background:black;border:1px solid lime;border-radius:14px;box-shadow:0 0 12px lime;padding:16px;text-align:center'><span style='background:lime;color:black;border-radius:6px;padding:3px 11px;font-size:13px;font-weight:bold'>MÁS VENDIDO</span><div style='font-size:60px'>🥐</div><b style='color:white;font-size:16px'>Medialunas x6</b><br><span style='color:lime;font-size:26px;font-weight:bold;text-shadow:0 0 8px lime'>$5</span><br><small style='color:lightgray'>1200 vendidos · ☕ Café de Mar</small><br><a href='/comprar/cafe1' style='display:block;background:fuchsia;color:white;padding:14px;border-radius:24px;text-decoration:none;font-weight:bold;margin-top:12px;font-size:18px;box-shadow:0 0 12px fuchsia'>Comprar</a></div></div></div>"
        contenido = contenido + "<h2 style='color:white;text-shadow:0 0 8px fuchsia'>🔥 Lo más vendido</h2><div>"
        para s en este.slugs {
            t = este.tiendas[s]
            para i en [0, 1, 2, 3, 4] {
                si (i < len(t["productos"])) {
                    p = t["productos"][i]
                    si (p["vendidos"] >= 100) {
                        contenido = contenido + este.tarjeta_neon(p, t, s, i)
                    }
                }
            }
        }
        contenido = contenido + "</div></div>"
        devolver este.envolver("NexusShop - El marketplace del futuro", contenido)
    }

    def directorio() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:20px'><h1 style='color:white;text-shadow:0 0 10px aqua'>🛍️ Tiendas verificadas</h1>"
        para s en este.slugs {
            t = este.tiendas[s]
            contenido = contenido + "<a href='/tienda/" + s + "' style='display:block;background:black;color:white;border:1px solid aqua;border-radius:14px;box-shadow:0 0 8px aqua;padding:20px;margin:12px 0;text-decoration:none'><b style='font-size:19px;color:white'>🛡️ " + t["emoji"] + " " + t["nombre"] + "</b> <span style='color:lightgray'>· ⭐ " + texto(t["estrellas"]) + " · " + texto(len(t["productos"])) + " productos</span></a>"
        }
        contenido = contenido + "</div>"
        devolver este.envolver("Tiendas - NexusShop", contenido)
    }

    def ofertas() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:20px'><h1 style='color:white;text-shadow:0 0 10px fuchsia'>🔥 Ofertas de la semana</h1>"
        contenido = contenido + "<div style='background:black;color:white;border:1px solid lime;border-radius:12px;padding:14px;margin:10px 0;font-size:14px'>✅ Precios honestos: el tachado es el precio de lista que el vendedor declara. Reportar un precio inflado falso = suspensión inmediata.</div>"
        para s en este.slugs {
            t = este.tiendas[s]
            para i en [0, 1, 2, 3, 4] {
                si (i < len(t["productos"])) {
                    p = t["productos"][i]
                    si (p["antes"] > 0) {
                        contenido = contenido + este.tarjeta_neon(p, t, s, i)
                    }
                }
            }
        }
        contenido = contenido + "</div>"
        devolver este.envolver("Ofertas - NexusShop", contenido)
    }

    def top() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:20px'><h1 style='color:white;text-shadow:0 0 10px lime'>🏆 Los más vendidos</h1>"
        para s en este.slugs {
            t = este.tiendas[s]
            para i en [0, 1, 2, 3, 4] {
                si (i < len(t["productos"])) {
                    p = t["productos"][i]
                    si (p["vendidos"] >= 300) {
                        contenido = contenido + este.tarjeta_neon(p, t, s, i)
                    }
                }
            }
        }
        contenido = contenido + "</div>"
        devolver este.envolver("Top - NexusShop", contenido)
    }

    def envios() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:30px 20px'><h1 style='color:white;text-shadow:0 0 10px aqua'>🚚 NexusEnvíos</h1>"
        contenido = contenido + este.caja("1. Comprás tocando un combo", "Elegís método de pago y de envío en la pantalla del producto. El pedido completo viaja a tu WhatsApp.")
        contenido = contenido + este.caja("2. El vendedor confirma", "Te responde por WhatsApp con total y coordinación. Todo queda escrito: tu comprobante natural.")
        contenido = contenido + este.caja("3. El vendedor entrega al operador", "Andreani, OCA, Correo Argentino o cadetería propia. El vendedor contrata; vos recibís seguimiento por chat.")
        contenido = contenido + este.caja("4. Recibís y pagás", "Contra entrega o transferencia confirmada. Nunca adelantás a desconocidos.")
        contenido = contenido + "<div style='background:black;color:white;border:1px solid fuchsia;border-radius:12px;box-shadow:0 0 10px fuchsia;padding:16px;margin-top:14px;font-size:14px'>⚖️ Transparencia: NexusShop NO manipula paquetes NI retiene pagos. Conecta, verifica y protege.</div></div>"
        devolver este.envolver("NexusEnvios - NexusShop", contenido)
    }

