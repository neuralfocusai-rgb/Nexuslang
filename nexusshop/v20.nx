    def nosotros() {
        contenido = "<div style='max-width:900px;margin:0 auto;padding:30px 20px;text-align:center'>" + este.logo("100px", "48px") + "<h1 style='color:white;text-shadow:0 0 10px lime'>🇦🇷 Nosotros</h1>"
