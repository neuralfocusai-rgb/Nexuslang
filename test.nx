متغیر نام = "حماد";
متغیر عمر = 25;
لکھو("سلام " + نام);
لکھو("آپ کی عمر ہے: " + عمر);
متغیر x = 10;
متغیر y = 3;
لکھو("جمع: " + (x + y));
لکھو("باقی: " + (x % y));
طریقہ سال_بعد(ع) {
    واپس ع + 1;
}
لکھو("سال بعد: " + سال_بعد(عمر));
اگر (عمر >= 18) {
    لکھو("آپ بالغ ہیں");
} ورنہ {
    لکھو("آپ نابالغ ہیں");
}
متغیر گنتی = 1;
جبکہ (گنتی <= 3) {
    لکھو("گنتی: " + گنتی);
    گنتی = گنتی + 1;
}
