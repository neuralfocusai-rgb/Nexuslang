// NexusLang v11 - Biblioteca estandar en Urdu
متغیر نمبر = 16;
لکھو("جذر: " + جذر(نمبر));

متغیر الف = 45;
متغیر ب = 90;
لکھو("بڑا: " + بڑا(الف, ب));
لکھو("چھوٹا: " + چھوٹا(الف, ب));

متغیر منفی = -7;
لکھو("مطلق: " + مطلق(منفی));

متغیر اعشاری = 3.7;
لکھو("گرد: " + گرد(اعشاری));

لکھو("لمبائی: " + لمبائی("پاکستان"));
