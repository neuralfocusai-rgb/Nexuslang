# NexusLang Urdu v10.1 - Listo para universidades

متغیر نام = "علی"
لکھو("سلام", نام)

فنکشن رقبہ(لمبائی, چوڑائی):
    متغیر نتیجہ = لمبائی * چوڑائی
    لکھو("رقبہ:", نتیجہ)
    واپس نتیجہ

رقبہ(10, 5)

اگر(85 > 50):
    لکھو("پاس")
ورنہ:
    لکھو("ناکام")

متغیر عمر = 20
لکھو("عمر: " + متن(عمر))

متغیر شمار = 0
جب تک(شمار < 3):
    لکھو("شمار:", شمار)
    شمار = شمار + 1
