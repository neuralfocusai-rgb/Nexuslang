// =============================================
// NexusLang v11 - نظام طالب علم
// Motor propio: lexer + parser + AST + interprete
// =============================================

متغیر کل_طلبہ = 0;
متغیر کل_نمبر = 0;

طریقہ شامل_کرو(نام, نمبر) {
    کل_طلبہ = کل_طلبہ + 1;
    کل_نمبر = کل_نمبر + نمبر;
    لکھو("طالب علم: " + نام + " | نمبر: " + نمبر);
    واپس نمبر;
}

طریقہ اوسط() {
    اگر (کل_طلبہ == 0) {
        واپس 0;
    }
    واپس کل_نمبر / کل_طلبہ;
}

طریقہ نتیجہ(نمبر) {
    اگر (نمبر >= 80) {
        واپس "شاندار";
    } ورنہ اگر (نمبر >= 50) {
        واپس "کامیاب";
    } ورنہ {
        واپس "ناکام";
    }
}

طریقہ فبوناچی(n) {
    اگر (n < 2) {
        واپس n;
    }
    واپس فبوناچی(n - 1) + فبوناچی(n - 2);
}

لکھو("=== اندراجِ طلبہ ===");
شامل_کرو("علی", 80);
شامل_کرو("فاطمہ", 70);
شامل_کرو("احمد", 30);

لکھو("اوسط: " + اوسط());
لکھو("علی کا نتیجہ: " + نتیجہ(80));
لکھو("احمد کا نتیجہ: " + نتیجہ(30));

لکھو("=== فبوناچی ===");
برائے (متغیر i = 0; i < 8; i = i + 1) {
    لکھو("f(" + i + ") = " + فبوناچی(i));
}

متغیر شمار = 3;
جبکہ (شمار > 0) {
    لکھو("باقی: " + شمار);
    شمار = شمار - 1;
}
لکھو("مکمل!");
