// NexusLang v11 - interprete propio, sintaxis propia
متغیر نام = "علی";
لکھو("سلام " + نام);

طریقہ رقبہ(لمبائی, چوڑائی) {
    متغیر نتیجہ = لمبائی * چوڑائی;
    واپس نتیجہ;
}

لکھو("رقبہ: " + رقبہ(10, 5));

اگر (85 > 50) {
    لکھو("پاس");
} ورنہ {
    لکھو("ناکام");
}

برائے (متغیر i = 0; i < 3; i = i + 1) {
    لکھو("شمار: " + i);
}
