// 1. Variables y Print
متغیر نام = "حماد";
متغیر عمر = 25;
لکھو("سلام " + نام);

// 2. Arrays
متغیر اعداد = [1, 2, 3, 4, 5];
لکھو("پہلا عدد: " + اعداد[0]);

// 3. For Loop
لکھو("--- For Loop ---");
برائے (متغیر i = 0; i < 3; i = i + 1) {
    لکھو("i = " + i);
}

// 4. Clase
کلاس طالب_علم {
    طریقہ خود(نام، نمبر) {
        خود.نام = نام;
        خود.نمبر = نمبر;
    }
    طریقہ دکھاؤ() {
        لکھو("طالب علم: " + خود.نام + " - نمبر: " + خود.نمبر);
    }
}
متغیر s = نیا طالب_علم("علی", 95);
s.دکھاؤ();

// 5. Try/Catch
لکھو("--- Try/Catch ---");
کوشش {
    متغیر x = 10 / 0;
} پکڑو (err) {
    لکھو("غلطی پکڑی گئی: " + err);
}

// 6. Import
درآمد len;
متغیر txt = "Hello";
لکھو("Length: " + len(txt));
